<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
        <ProjectVersion>19.0</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <MainSource>VFI.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <TargetedPlatform>Win32</TargetedPlatform>
        <SanitizedProjectName>VFI</SanitizedProjectName>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Config)'=='Base'">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_Optimize>false</DCC_Optimize>
        <VerInfo_Locale>1046</VerInfo_Locale>
    </PropertyGroup>

    <PropertyGroup>
        <DCC_UnitSearchPath>Domain;Data;Services;UI;Tests;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Namespace>System;Vcl;Winapi;Data;Xml;Web;Soap;System.Win;Bde;IBX</DCC_Namespace>
        <DCC_UsePackage>false</DCC_UsePackage>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <BT_BuildType>Debug</BT_BuildType>
        <DCC_DcuOutputDir>.\$(Config)\dcu</DCC_DcuOutputDir>
        <DCC_ExeOutputDir>.\$(Config)</DCC_ExeOutputDir>
    </PropertyGroup>

    <ItemGroup>
        <DCCReference Include="VFI.dpr"/>
        <DCCReference Include="Domain\VFI.Domain.Entities.pas"/>
        <DCCReference Include="Domain\VFI.Domain.Enums.pas"/>
        <DCCReference Include="Domain\VFI.Domain.Interfaces.pas"/>
        <DCCReference Include="Data\VFI.Data.Config.pas"/>
        <DCCReference Include="Data\VFI.Data.Connection.pas"/>
        <DCCReference Include="Data\VFI.Data.Repository.pas"/>
        <DCCReference Include="Services\VFI.AppModule.pas"/>
        <DCCReference Include="Services\VFI.Services.FiscalValidator.pas"/>
        <DCCReference Include="Services\VFI.Services.TaxCalculator.pas"/>
        <DCCReference Include="Services\VFI.Services.AIAnalyzer.pas"/>
        <DCCReference Include="Services\VFI.Services.VB6Bridge.pas"/>
        <DCCReference Include="UI\VFI.UI.MainController.pas"/>
        <DCCReference Include="UI\VFI.UI.MainForm.pas">
            <Form>VFI.UI.MainForm.dfm</Form>
        </DCCReference>
    </ItemGroup>

    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
